# ---------- LLM ----------
# Provider: gemini (default) | groq | ollama
LLM_PROVIDER=gemini
# Leave empty to use the provider default:
#   gemini -> gemini-flash-lite-latest (flash has only ~20 req/day on free tier) | groq -> llama-3.3-70b-versatile | ollama -> qwen2.5:7b
LLM_MODEL=

# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Retry/backoff on 429 + pause between requests in demo scripts (seconds)
LLM_MAX_RETRIES=5
LLM_REQUEST_DELAY=6

# Company name used in draft customer replies (optional)
COMPANY_NAME=

# ---------- Telegram (Phase 4) ----------
# Create a bot with @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# ---------- Storage ----------
DATABASE_PATH=data/leads.db
# Optional Google Sheets mirror - enabled only if both are set (see README: Google Sheets setup)
# e.g. GOOGLE_SHEETS_CREDENTIALS_FILE=credentials/google-service-account.json
# GOOGLE_SHEET_ID is the long id in the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEET_ID=

# ---------- Server ----------
HOST=127.0.0.1
PORT=8000
